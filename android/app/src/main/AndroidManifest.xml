<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Family theme-sync. XX-Launcher defines and sendBroadcast()s with this
         signature permission; uses-permission is required to receive it. -->
    <uses-permission android:name="com.piercingxx.xxlauncher.permission.THEME_SYNC" />

    <application
        android:name=".XxDriveApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.XXDrive"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Cleartext policy lives in @xml/network_security_config: the DEBUG
             build type overrides that whole file to permit plain HTTP (the
             server address is user-entered LAN http://192.168.x.x, and NSC
             cannot wildcard IP ranges), while this main variant — used by
             every non-debug build — denies cleartext outright. -->

        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />

        <!-- Family-wide theme sync: the xx-launcher targets this package
             explicitly (required since Android O for manifest receivers)
             with its active-theme broadcast. exported=true is required for a
             different app to deliver it; android:permission gates senders to
             holders of our signature-level THEME_SYNC permission. -->
        <receiver
            android:name=".theme.ThemeSyncReceiver"
            android:exported="true"
            android:permission="com.piercingxx.xxlauncher.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="xx.launcher.THEME_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
