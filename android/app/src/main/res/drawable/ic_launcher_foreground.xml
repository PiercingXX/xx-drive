<?xml version="1.0" encoding="utf-8"?>
<!--
  PiercingXX logomark (BRAND-GUIDE.md §5): two X's of two bars crossing at ±45°,
  stacked vertically and overlapping by a quarter of their height, in Signal
  white, underlined by a white bar, on Ink.

  Traced from branding/assets/logomark.svg. That master is a 512 tile; this is
  the adaptive-icon FOREGROUND, so it is drawn on the same 512 grid but scaled
  about the centre to sit inside the adaptive icon's safe zone. The mark is
  taller than it is wide, so height is what binds: unscaled it spans y 66.5→446
  about a centre of (256, 256), a bounding radius of ~212. The safe zone is a
  ~313-diameter circle, and §5 asks for at least a bar-width of clear space on
  all sides whatever shape the mask is, so the scale has to satisfy
  212·s + 56·s ≤ 156.5 — hence 0.58, which leaves ~1.03 bar-widths of Ink.

  The Ink tile is the background layer, not this one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.58"
        android:scaleY="0.58">

        <!-- Top X, centred on (256,157). Each bar is a 56×200 capsule (rx=28
             in the master, i.e. semicircular ends). -->
        <group
            android:pivotX="256"
            android:pivotY="157"
            android:rotation="45">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M228,85 a28,28 0 0 1 56,0 L284,229 a28,28 0 0 1 -56,0 Z" />
        </group>
        <group
            android:pivotX="256"
            android:pivotY="157"
            android:rotation="-45">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M228,85 a28,28 0 0 1 56,0 L284,229 a28,28 0 0 1 -56,0 Z" />
        </group>

        <!-- Bottom X, centred on (256,292). The centres sit 135 apart while
             each X is 181 tall, so they overlap by 46 — a quarter (§5 forbids
             changing this). -->
        <group
            android:pivotX="256"
            android:pivotY="292"
            android:rotation="45">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M228,220 a28,28 0 0 1 56,0 L284,364 a28,28 0 0 1 -56,0 Z" />
        </group>
        <group
            android:pivotX="256"
            android:pivotY="292"
            android:rotation="-45">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M228,220 a28,28 0 0 1 56,0 L284,364 a28,28 0 0 1 -56,0 Z" />
        </group>

        <!-- The underline. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M183,402 l146,0 a22,22 0 0 1 0,44 l-146,0 a22,22 0 0 1 0,-44 z" />
    </group>

</vector>
