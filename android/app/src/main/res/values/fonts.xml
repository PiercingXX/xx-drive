<?xml version="1.0" encoding="utf-8"?>
<!--
  BRAND-GUIDE.md §4: monospace IS the identity. Space Mono for display,
  JetBrains Mono for body/UI.

  Both faces now ship as real TTFs in res/font/ (§12.1 type ramp). The
  indirection stays, as same-type font aliases: layouts reference
  @font/font_display / @font/font_body, so swapping a face is a one-line
  change here.
-->
<resources>
    <item name="font_display" type="font">@font/spacemono_regular</item>
    <item name="font_body" type="font">@font/jetbrainsmono_regular</item>
</resources>
