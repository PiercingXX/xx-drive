# nginx reverse proxy for xx-drive — TLS termination in front of the server.
#
# Install (adjust server_name + cert paths) and reload:
#   cp deploy/nginx.conf.example /etc/nginx/sites-available/xxdrive
#   ln -s ../sites-available/xxdrive /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# The xxdrive unit must keep binding 127.0.0.1:8080 and MUST run with
# `-secure-cookies` so session/share cookies carry Secure (the server does
# NOT read X-Forwarded-Proto for this — see docs/MANUAL.md §4).

limit_req_zone $binary_remote_addr zone=xxdrive_login:10m rate=30r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name drive.example.com;

    ssl_certificate     /etc/ssl/certs/drive.example.com.fullchain.pem;
    ssl_certificate_key /etc/ssl/private/drive.example.com.key;

    # Large uploads: match the server's -max-upload-mb (default 10240 MB).
    # Without this nginx 413s anything over its 1 MB default.
    client_max_body_size 10g;
    client_body_timeout 300s;

    # Real host for the server's CSRF same-origin check (Origin/Referer vs r.Host).
    proxy_set_header Host $host;
    # Informational only — xx-drive does not trust these for security decisions.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_buffering off;   # safe for downloads/zips; harmless otherwise

    location / {
        proxy_pass http://127.0.0.1:8080;
    }

    # /api/events is plain JSON polling today (no WebSocket/SSE). If it ever
    # becomes a stream, switch it to an upgrade-capable passthrough:
    #   location /api/events {
    #       proxy_pass http://127.0.0.1:8080;
    #       proxy_set_header Upgrade $http_upgrade;
    #       proxy_set_header Connection "upgrade";
    #       proxy_buffering off;
    #   }

    # /healthz is unauthenticated by design (fingerprinting = LOW concern).
    # Keep it off the public internet if you care:
    location = /healthz {
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://127.0.0.1:8080;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name drive.example.com;
    return 301 https://$host$request_uri;
}
